#!/usr/bin/env bash
# Symmetric Chinwag release builder & bus publisher wrapper (`CHWG-0261`).
# Compiles `--release --locked` on any authorized peer, uploads the content-addressed
# binary to Cloudflare R2, installs locally at `$HOME/.local/bin/<binary>`, and
# broadcasts a signed `RELEASE_BUILT` manifest onto `#all` on the Chinwag Bus.

set -euo pipefail

if [[ -z "${HOME:-}" || "${HOME:0:1}" != "/" ]]; then
  echo "chinwag-release-publish: HOME must be set to an absolute directory" >&2
  exit 2
fi

export PATH="/opt/homebrew/opt/rustup/bin:${HOME}/.cargo/bin:${HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"
export RUSTUP_TOOLCHAIN="${RUSTUP_TOOLCHAIN:-1.97.1}"
if [[ -d "${HOME}/.chinwag-native-inputs" ]]; then
  export CHINWAG_PRIVATE_CRSQL_INPUTS="${CHINWAG_PRIVATE_CRSQL_INPUTS:-${HOME}/.chinwag-native-inputs}"
fi

BINARY="chinwag"
REPO_ROOT="${CHINWAG_REPO_ROOT:-}"
SOURCE_BIN=""
ROLLBACK=0
JSON_OUT=0
FROM_ACTOR=""

usage() {
  cat <<'EOF'
Usage:
  chinwag-release-publish [--binary chinwag|chinwag-ci] [--repo <repo-path>]
                          [--source <precompiled-binary>] [--from <INFRAJR#INSTANCE>]
                          [--rollback] [--json]
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --binary)
      BINARY="${2:-}"
      shift 2
      ;;
    --repo)
      REPO_ROOT="${2:-}"
      shift 2
      ;;
    --source)
      SOURCE_BIN="${2:-}"
      shift 2
      ;;
    --from)
      FROM_ACTOR="${2:-}"
      shift 2
      ;;
    --rollback)
      ROLLBACK=1
      shift
      ;;
    --json)
      JSON_OUT=1
      shift
      ;;
    -h|--help|help)
      usage
      exit 0
      ;;
    *)
      echo "chinwag-release-publish: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ "$BINARY" != "chinwag" && "$BINARY" != "chinwag-ci" ]]; then
  echo "chinwag-release-publish: --binary must be 'chinwag' or 'chinwag-ci'" >&2
  exit 2
fi

if [[ -z "$REPO_ROOT" ]]; then
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    REPO_ROOT="$(git rev-parse --show-toplevel)"
  elif [[ -d "${HOME}/WORKSPACE/chinwag/.git" || -f "${HOME}/WORKSPACE/chinwag/.git" ]]; then
    REPO_ROOT="${HOME}/WORKSPACE/chinwag"
  else
    echo "chinwag-release-publish: pass --repo <path> or run inside a chinwag checkout" >&2
    exit 2
  fi
fi

TARGET_DIR="${CARGO_TARGET_DIR:-${REPO_ROOT}/target}"
BUILD_META_DIR=""
cleanup_build_meta() {
  if [[ -n "${BUILD_META_DIR:-}" && -d "${BUILD_META_DIR}" ]]; then
    rm -rf "${BUILD_META_DIR}"
  fi
}
trap cleanup_build_meta EXIT

if [[ -z "$SOURCE_BIN" ]]; then
  umask 077
  BUILD_META_DIR="$(mktemp -d "${TMPDIR:-/tmp}/chinwag-release-build.XXXXXX")"
  CARGO_JSON_LOG="${BUILD_META_DIR}/cargo-messages.jsonl"
  cargo build \
    --manifest-path "${REPO_ROOT}/Cargo.toml" \
    --target-dir "${TARGET_DIR}" \
    --release \
    --bin "${BINARY}" \
    --locked \
    --message-format=json-render-diagnostics >"$CARGO_JSON_LOG"
  SOURCE_BIN="$(python3 - "$CARGO_JSON_LOG" "$BINARY" <<'PY'
import json
import sys

log_path, want_bin = sys.argv[1], sys.argv[2]
matches = []
with open(log_path, "r", encoding="utf-8") as fh:
    for raw in fh:
        raw = raw.strip()
        if not raw:
            continue
        obj = json.loads(raw)
        if obj.get("reason") != "compiler-artifact":
            continue
        target = obj.get("target") or {}
        kinds = target.get("kind") or []
        exe = obj.get("executable")
        if (
            target.get("name") == want_bin
            and "bin" in kinds
            and isinstance(exe, str)
            and exe
        ):
            matches.append(exe)

if len(matches) != 1:
    sys.stderr.write(
        f"chinwag-release-publish: expected exactly 1 executable artifact for {want_bin}, got {len(matches)}\n"
    )
    sys.exit(1)

print(matches[0])
PY
)"
  rm -rf "$BUILD_META_DIR"
  BUILD_META_DIR=""
fi

if [[ ! -f "$SOURCE_BIN" || -L "$SOURCE_BIN" ]]; then
  echo "chinwag-release-publish: compiled binary not found or is a symlink at ${SOURCE_BIN}" >&2
  exit 1
fi

RUNNER_CHINWAG="${HOME}/.local/bin/chinwag"
if [[ "$BINARY" == "chinwag" && -x "$SOURCE_BIN" ]]; then
  RUNNER_CHINWAG="$SOURCE_BIN"
fi

PUBLISH_ARGS=(
  release publish
  --binary "$BINARY"
  --source "$SOURCE_BIN"
  --repo "$REPO_ROOT"
)
if [[ -n "$FROM_ACTOR" ]]; then
  PUBLISH_ARGS+=(--from "$FROM_ACTOR")
fi
if [[ "$ROLLBACK" -eq 1 ]]; then
  PUBLISH_ARGS+=(--rollback)
fi
if [[ "$JSON_OUT" -eq 1 ]]; then
  PUBLISH_ARGS+=(--json)
fi

SCRIPT_SELF="${REPO_ROOT}/scripts/chinwag-release-publish"
if [[ -f "$SCRIPT_SELF" && ! -L "$SCRIPT_SELF" && ! -L "${HOME}/.local" && ! -L "${HOME}/.local/bin" && ! -L "${HOME}/.local/bin/chinwag-release-publish" ]]; then
  mkdir -p "${HOME}/.local/bin"
  WRAPPER_TMP="$(mktemp "${HOME}/.local/bin/.chinwag-release-publish.tmp.XXXXXX")"
  cp "$SCRIPT_SELF" "$WRAPPER_TMP"
  chmod 0755 "$WRAPPER_TMP"
  mv -f "$WRAPPER_TMP" "${HOME}/.local/bin/chinwag-release-publish"
fi

exec -a chinwag "$RUNNER_CHINWAG" "${PUBLISH_ARGS[@]}"
