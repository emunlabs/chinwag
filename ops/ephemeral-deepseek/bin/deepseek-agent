#!/usr/bin/env python3
"""DeepSeek 4.1 CLI runner on Cloudflare Workers AI (@cf/deepseek-ai/deepseek-v4.1-flash-1017 via cloudflareos-ai Gateway) for Chinwag Ephemeral Dev (DEV-1..DEV-5) & QA (QA-1..QA-5) Slots.

2026-11-01 empty-content fix (branch eng/deepseek-empty-content-fix):
  * sends reasoning_effort + max_completion_tokens (max_tokens kept only so the
    pre-fix Worker, which ignores max_completion_tokens, still gets a real budget)
  * effort: env EPHEMERAL_DEEPSEEK_REASONING (none|low|high|max) else QA seats
    (env EPHEMERAL_SEAT starting with "QA") -> none, else low
  * never swallows errors: every failure prints a clear one-line reason to stderr
  * exits 1 when content is empty or finish_reason is "length" (partial output is
    never printed as if it were a result)
  * one retry at a lower effort on "length" (disable with EPHEMERAL_DEEPSEEK_RETRY=0;
    the run_job_v2 harness disables it because it forbids a second provider attempt)
"""
import argparse
import json
import os
from pathlib import Path
import sys
import urllib.error
import urllib.parse
import urllib.request

EFFORTS = ("none", "low", "high", "max")
LOWER_EFFORT = {"max": "high", "high": "low", "low": "none"}
MAX_COMPLETION_TOKENS = 32768
OUTPUT_CONTRACT = (
    " Output contract: answer in the requested output format only; when JSON is requested, return only that"
    " JSON with no preamble or code fences. Keep your reasoning brief and always finish the answer; never use"
    " your whole output budget on reasoning."
)


class EngineError(Exception):
    """A failure with a clear, secret-free, one-line reason."""


class ModelOutputError(EngineError):
    """The call succeeded but the answer is empty or truncated (not a transport problem)."""


def log(msg: str) -> None:
    sys.stderr.write(f"deepseek-agent: {msg}\n")


def load_env_key(names: list[str]) -> str:
    for name in names:
        val = os.environ.get(name, "").strip()
        if val:
            return val
    parsed: dict[str, str] = {}
    for ef in [Path.home() / ".hermes" / ".env", Path.home() / ".env"]:
        if not ef.exists():
            continue
        for line in ef.read_text(errors="ignore").splitlines():
            s = line.strip()
            if not s or s.startswith("#") or "=" not in s:
                continue
            if s.startswith("export "):
                s = s[7:].strip()
            k, v = s.split("=", 1)
            parsed[k.strip()] = v.strip().strip('"').strip("'")
    for name in names:
        if parsed.get(name):
            return parsed[name]
    return ""


def resolve_effort() -> str:
    raw = os.environ.get("EPHEMERAL_DEEPSEEK_REASONING", "").strip().lower()
    if raw:
        if raw in EFFORTS:
            return raw
        log(f"ignoring invalid EPHEMERAL_DEEPSEEK_REASONING={raw[:20]!r} (allowed: {', '.join(EFFORTS)})")
    seat = os.environ.get("EPHEMERAL_SEAT", "").strip().upper()
    return "none" if seat.startswith("QA") else "low"


def retry_enabled() -> bool:
    return os.environ.get("EPHEMERAL_DEEPSEEK_RETRY", "1").strip() not in ("0", "false", "no")


def parse_worker_payload(payload: dict) -> dict:
    """Return {text, finish_reason, usage}. Accepts the fixed Worker shape and the pre-fix
    Worker, which put a serialized chat.completion in `response` when content was empty."""
    if not isinstance(payload, dict) or not payload.get("ok"):
        err = payload.get("error") if isinstance(payload, dict) else None
        raise EngineError(f"Worker reported failure: {str(err)[:200] if err else 'ok=false'}")
    text = payload.get("response")
    text = text if isinstance(text, str) else ""
    finish = payload.get("finish_reason")
    usage = payload.get("usage")
    stripped = text.lstrip()
    if stripped.startswith("{") and '"choices"' in stripped[:2000]:
        try:
            env = json.loads(text)
            choice = (env.get("choices") or [{}])[0]
            content = (choice.get("message") or {}).get("content")
            if isinstance(content, list):
                content = "".join(p.get("text", "") for p in content if isinstance(p, dict))
            text = content if isinstance(content, str) else ""
            finish = choice.get("finish_reason", finish)
            usage = env.get("usage", usage)
        except (ValueError, AttributeError, IndexError, TypeError):
            pass  # a genuine answer that merely mentions "choices"; keep as text
    return {"text": text.strip(), "finish_reason": finish, "usage": usage}


def check_result(res: dict, where: str) -> None:
    """Raise EngineError unless the result is a complete, non-empty answer."""
    fin = res["finish_reason"]
    comp = (res.get("usage") or {}).get("completion_tokens") if isinstance(res.get("usage"), dict) else None
    detail = f"finish_reason={fin}" + (f", completion_tokens={comp}" if comp is not None else "")
    if fin == "length":
        why = "output truncated" if res["text"] else "empty content (reasoning likely consumed the whole budget)"
        raise ModelOutputError(f"{where}: {why} ({detail})")
    if not res["text"]:
        raise ModelOutputError(f"{where}: empty content ({detail})")


def post_json(url: str, body: dict, headers: dict, timeout: int) -> dict:
    req = urllib.request.Request(url, data=json.dumps(body).encode("utf-8"), headers=headers, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        try:
            detail = e.read().decode("utf-8", "replace")[:200]
        except Exception:  # noqa: BLE001 - best effort body for the message only
            detail = ""
        raise EngineError(f"HTTP {e.code} from {urllib.parse.urlparse(url).netloc}: {detail}".strip()) from None
    except urllib.error.URLError as e:
        raise EngineError(f"transport error to {urllib.parse.urlparse(url).netloc}: {e.reason}") from None


def run_worker(cf_worker_url: str, cf_secret: str, model: str, messages: list, effort: str) -> str:
    """Primary path. Returns text, or raises EngineError (transport/HTTP/empty/length)."""
    attempts = 0
    while True:
        attempts += 1
        body = {
            "model": model,
            "messages": messages,
            "temperature": 0.2,
            "reasoning_effort": effort,
            "max_completion_tokens": MAX_COMPLETION_TOKENS,
            # Only for the pre-fix Worker (reads max_tokens, defaults to 2048). Remove after Worker deploy.
            "max_tokens": MAX_COMPLETION_TOKENS,
        }
        payload = post_json(
            cf_worker_url,
            body,
            {
                "Content-Type": "application/json",
                "Authorization": f"Bearer {cf_secret}",
                "User-Agent": "chinwag-ephemeral-deepseek-4.1/1.1",
            },
            600,
        )
        res = parse_worker_payload(payload)
        try:
            check_result(res, f"workers-ai effort={effort}")
        except EngineError as err:
            if res["finish_reason"] == "length" and attempts == 1 and retry_enabled() and effort in LOWER_EFFORT:
                lower = LOWER_EFFORT[effort]
                log(f"{err}; retrying once at reasoning_effort={lower}")
                effort = lower
                continue
            raise
        return res["text"]


def run_openrouter(or_key: str, messages: list) -> str:
    payload = post_json(
        "https://openrouter.ai/api/v1/chat/completions",
        {"model": "deepseek/deepseek-v4.1-flash-1017", "messages": messages, "temperature": 0.2, "max_tokens": MAX_COMPLETION_TOKENS},
        {
            "Content-Type": "application/json",
            "Authorization": f"Bearer {or_key}",
            "HTTP-Referer": "https://chinwag.sh",
            "X-Title": "Chinwag Ephemeral Slot (DeepSeek 4.1)",
        },
        600,
    )
    choices = payload.get("choices") or []
    if not choices:
        raise EngineError("openrouter: no choices in response")
    content = (choices[0].get("message") or {}).get("content") or ""
    res = {"text": content.strip(), "finish_reason": choices[0].get("finish_reason"), "usage": payload.get("usage")}
    check_result(res, "openrouter")
    return res["text"]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=["status", "run"])
    parser.add_argument("prompt", nargs="?")
    parser.add_argument("--model", default="@cf/deepseek-ai/deepseek-v4.1-flash-1017")
    args = parser.parse_args()

    cf_worker_url = "https://chinwag-deepseek-v41.brianspector.workers.dev"

    if args.action == "status":
        print(
            json.dumps(
                {
                    "ok": True,
                    "provider": "cloudflare-workers-ai",
                    "gateway": "cloudflareos-ai",
                    "endpoint": cf_worker_url,
                    "model": args.model,
                    "reasoning_effort": resolve_effort(),
                    "max_completion_tokens": MAX_COMPLETION_TOKENS,
                }
            )
        )
        return 0

    prompt = args.prompt if args.prompt is not None else sys.stdin.read()
    if not prompt or not prompt.strip():
        sys.stderr.write("deepseek-agent: prompt required\n")
        return 2

    cf_secret = load_env_key(["INTAKE_INTERNAL_API_BEARER_TOKEN", "WORKER_AUTH_SECRET"])
    sys_msg = (
        "You are a Chinwag Ephemeral Engineering/QA Agent (DEV-1..5 / QA-1..5) running on "
        "DeepSeek 4.1 on Cloudflare Workers AI (@cf/deepseek-ai/deepseek-v4.1-flash-1017 via "
        "cloudflareos-ai Gateway — INV-MODELS-DEV-LATEST-01). Execute the assigned task concisely and accurately."
        " Brian direct instruction 2026-10-30: Chinwag product code is Rust only. Implement the backend, GPUI integration, runtime services, launcher and product tests in Rust. Do not introduce Python product code or a Python runtime dependency. Apply this rule to every DEV-1 through DEV-5 and QA-1 through QA-5 assignment and review. Flag any proposed non-Rust product implementation instead of generating it."
        + OUTPUT_CONTRACT
    )
    messages = [
        {"role": "system", "content": sys_msg},
        {"role": "user", "content": prompt},
    ]
    effort = resolve_effort()
    failures = []

    # 1. Primary: Cloudflare Workers AI via the chinwag-deepseek-v41 Worker + cloudflareos-ai Gateway.
    if cf_secret:
        try:
            print(run_worker(cf_worker_url, cf_secret, args.model, messages, effort))
            return 0
        except ModelOutputError as err:
            # An empty/truncated answer is a model-behaviour failure: do not hide it behind a
            # different model. Transport/HTTP failures may still fall through to OpenRouter.
            log(str(err))
            return 1
        except EngineError as err:
            failures.append(str(err))
            log(str(err))
        except Exception as err:  # noqa: BLE001 - surface the type, never swallow
            msg = f"workers-ai: unexpected {type(err).__name__}: {str(err)[:200]}"
            failures.append(msg)
            log(msg)
    else:
        log("no Worker credential found (INTAKE_INTERNAL_API_BEARER_TOKEN / WORKER_AUTH_SECRET); skipping Workers AI")

    # 2. Fallback: OpenRouter DeepSeek 4.1 (only when a key is configured).
    or_key = load_env_key(["OPENROUTER_API_KEY"])
    if or_key:
        try:
            print(run_openrouter(or_key, messages))
            return 0
        except EngineError as err:
            failures.append(str(err))
            log(str(err))
        except Exception as err:  # noqa: BLE001
            msg = f"openrouter: unexpected {type(err).__name__}: {str(err)[:200]}"
            failures.append(msg)
            log(msg)

    log("no result from any DeepSeek 4.1 endpoint" + (f" ({'; '.join(failures)})" if failures else ""))
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
